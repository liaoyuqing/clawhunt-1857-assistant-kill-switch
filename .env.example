# All configuration comes from environment variables; nothing is hard-coded.
ASST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/asst_killswitch
ASST_REDIS_URL=redis://127.0.0.1:6379/0
ASST_CACHE_TTL_SECONDS=5
ASST_SSE_FRAME_INTERVAL_SECONDS=0.05
# Emergency brake: true/1/yes/on turns the assistant off without touching Postgres or Redis.
ASST_FORCE_OFF=false
# Optional operator note shown in GET /api/assistant/status while the brake is on.
ASST_FORCE_OFF_REASON=
